<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.maxim618</groupId>
        <artifactId>micro-env-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>micro-env</artifactId>

    <name>micro-env</name>
    <description>Lightweight environment configuration library for Spring Boot applications</description>
    <url>https://github.com/maxim618/micro-env</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Maxim Butmanov</name>
            <url>https://github.com/maxim618</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/maxim618/micro-env.git</connection>
        <developerConnection>scm:git:https://github.com/maxim618/micro-env.git</developerConnection>
        <url>https://github.com/maxim618/micro-env</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <spring-boot.version>4.1.0</spring-boot.version>
        <flatten.skip>false</flatten.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
